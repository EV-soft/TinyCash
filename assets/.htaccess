# /assets/.htaccess v:1.3.1 d:2026-09-15 i:evs
# CSS/JS linkes altid med ?v=<ændringstid> (tc_asset()), så en ny version får en ny adresse - derfor må de caches længe.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
