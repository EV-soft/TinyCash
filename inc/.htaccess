# inc/.htaccess  renamed from "..htaccess"

# 1. Benægt adgang til alt som standard
Require all denied

# 2. Tillad adgang til login-siden, så man kan logge ind
<Files "login.php">
    Require all granted
</Files>

# 3. Tillad adgang til forsiden (index) efter login
<Files "index.php">
    Require all granted
</Files>

# 4. RETTET 2026-08-19: undtagelsen for Master_Advisor.php er fjernet.
# Filen (og master_advisor2.php/master_reconstructor.php) dumper hele
# kildekoden + databaseskemaet og sletter gamle eksportfiler - havde INTET
# PHP-login-tjek, og var derfor reelt offentligt tilgængelig for enhver på
# internettet på grund af netop denne undtagelse. De tre filer har nu deres
# eget admin-tjek i selve PHP-koden i stedet (defensivt lag, uafhængigt af
# denne .htaccess) - ingen af dem behøver længere en undtagelse her.

# 5. Tillad adgang til notepads gemme-funktion
<Files "notepad.inc.php">
    Require all granted
</Files>