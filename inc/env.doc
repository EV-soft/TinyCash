; inc/env.doc  v:1.1.0 d:2026-07-02 i:evs

Instructions for filling out inc/env.ini

; inc/env.ini // inc/.env v:1.1.0 d:2026-07-02 i:evs
; In this file you provide critical criteria for connecting to different systems. 
; Be careful. The file may only be found in the inc folder which is secured with .htaccess

;----DB-selector: -----------------------------

; Database select Type: "mysql" or "sqlite"
; Uncomment one of following two lines to Aktivate:	IMPORTANT
;ACTIVE_DB="mysql_config"
ACTIVE_DB="sqlite_config"

[mysql_config]
DB_TYPE="mysql"
DB_HOST="localhost"			(default)
DB_USER="<db-server-admin>"		IMPORTANT
DB_PASS="<db-admin-password>"		IMPORTANT
DB_NAME="<db-server-name>"		IMPORTANT

[sqlite_config]
DB_TYPE="sqlite"
DB_PATH="data/tinycash.sqlite"		(default)

;----Incomming mails: ------------------------- Check with your provider!

; 1. SALES: Copies of own issued customer invoices (Money IN)
IMAP_INVOICE_SERVER="{mail.<hostname>:993/imap/ssl/novalidate-cert}INBOX"
IMAP_INVOICE_USER="<invoice@hostname>"
IMAP_INVOICE_PASS="<email-password>"

; 2. PURCHASE: Small expenses, receipts and vouchers (Money OUT)
IMAP_VOUCHER_SERVER="{mail.<hostname>:993/imap/ssl/novalidate-cert}INBOX"
IMAP_VOUCHER_USER="<voucher@hostname>"
IMAP_VOUCHER_PASS="<email-password>"

; 3. PURCHASE: Real purchase/supplier invoices (Money OUT)
IMAP_VENDOR_SERVER="{mail.<hostname>:993/imap/ssl/novalidate-cert}INBOX"
IMAP_VENDOR_USER="<vendor@hostname>"
IMAP_VENDOR_PASS="<email-password>"



